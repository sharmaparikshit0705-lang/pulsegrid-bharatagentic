# ---- PulseGrid server configuration ----
PORT=4000
NODE_ENV=development

# PostgreSQL + PostGIS
PGHOST=localhost
PGPORT=5432
PGDATABASE=pulsegrid
PGUSER=pulsegrid
PGPASSWORD=change-me

# Vision model for road-damage analysis (optional).
# Point this at any JSON endpoint that accepts { model, mimeType, image (base64),
# task } and returns the verdict object { hasPothole, severityScore, damageType,
# recommendedAction, estimatedSizeCm, confidence }.
# With no endpoint configured the service uses a deterministic, clearly-labelled
# fallback so the prototype still runs.
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=pulsegrid-vision-v1

# Storage for citizen photo uploads (absolute or relative to server root)
UPLOAD_DIR=uploads

# CORS origin allowed to call the API
CORS_ORIGIN=http://localhost:5173
