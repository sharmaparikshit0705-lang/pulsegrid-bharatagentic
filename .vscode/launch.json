{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PulseGrid: debug the agent API",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/src/index.js",
      "cwd": "${workspaceFolder}/server",
      "env": { "PORT": "4000", "NODE_ENV": "development" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "PulseGrid: run the agent self-evals",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/client/scripts/agent-test.mjs",
      "cwd": "${workspaceFolder}/client",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
